# Variables de entorno de ejemplo para SmartLog Analyzer.
# Copiar este archivo a .env y ajustar los valores antes de levantar con docker compose.
# Nunca subir valores reales (API keys, contraseñas) al repositorio.

DB_PASSWORD=YourStrong!Passw0rd

# Proveedor de LLM: "mock" (por defecto, sin costo ni API key) o "openai".
LLM__Provider=mock
LLM__ApiKey=
LLM__BaseUrl=https://api.openai.com/v1

ASPNETCORE_ENVIRONMENT=Production
